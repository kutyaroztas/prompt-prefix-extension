{
  "manifest_version": 3,
  "name": "Prompt Prefix Injector",
  "version": "1.0.0",
  "description": "Odaklanilan chat input kutusuna (ChatGPT, Claude, Gemini, Perplexity, Grok) hazir persona/on-ek metni ekler.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Prompt Prefix Injector"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://grok.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
